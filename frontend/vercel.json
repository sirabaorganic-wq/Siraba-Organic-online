{
  "redirects": [
    {
      "source": "/certification.html",
      "destination": "/certifications",
      "permanent": true
    },
    {
      "source": "/certification",
      "destination": "/certifications",
      "permanent": true
    },
    {
      "source": "/vendor/qualification",
      "destination": "/vendor-qualification",
      "permanent": true
    },
    {
      "source": "/vendor-intro",
      "destination": "/vendor",
      "permanent": true
    },
    {
      "source": "/vendor/intro",
      "destination": "/vendor",
      "permanent": true
    },
    {
      "source": "/marketplace-badges",
      "destination": "/vendor/badges",
      "permanent": true
    },
    {
      "source": "/our-story",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/about-us",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/contact-us",
      "destination": "/contact",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/llms.txt",
      "destination": "/llms.txt"
    },
    {
      "source": "/((?!robots\\.txt|sitemap\\.xml|llms\\.txt|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}